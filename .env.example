# Copy to .env before `docker compose up`.
# Native zero-docker run does not require any .env file!

# ── Analytics DB (Optional Override) ─────────────────────────────────────────
# Defaults to in-memory H2. Set to PostgreSQL connection string in production.
#ANALYTICS_DB_URL=jdbc:postgresql://localhost:5437/analytics
#ANALYTICS_DB_USER=shortener
#ANALYTICS_DB_PASSWORD=shortener

# ── Sharding (Track B, ADR-002) ────────────────────────────────────────────
# Compose hard-codes SHARDING_ENABLED=true for the app containers; this value
# only matters for host-side runs (`mvn spring-boot:run`), where the default
# is false (SingleShardRouter stub, no shard DBs needed).
SHARDING_ENABLED=false
# JDBC URLs default to the compose-network hostnames (shard1-primary:5432, …).
# For a host-side app against the compose DBs, uncomment the localhost ports:
#SHARD1_PRIMARY_URL=jdbc:postgresql://localhost:5433/shortener
#SHARD1_REPLICA_URL=jdbc:postgresql://localhost:5434/shortener
#SHARD2_PRIMARY_URL=jdbc:postgresql://localhost:5435/shortener
#SHARD2_REPLICA_URL=jdbc:postgresql://localhost:5436/shortener
#SHARD_DB_USER=shortener
#SHARD_DB_PASSWORD=shortener
#SHARD_POOL_SIZE=10
