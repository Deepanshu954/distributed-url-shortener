# Local environment configuration for Docker Compose and local runs
NODE_ID=1
APP_BASE_URL=http://localhost
CODE_LENGTH=5
SHARDING_ENABLED=true
RATELIMIT_ENABLED=true
KAFKA_ENABLED=true

# Shard Ports (Host Mappings)
SHARD1_PRIMARY_URL=jdbc:postgresql://shard1-primary:5432/shortener
SHARD1_REPLICA_URL=jdbc:postgresql://shard1-replica:5432/shortener
SHARD2_PRIMARY_URL=jdbc:postgresql://shard2-primary:5432/shortener
SHARD2_REPLICA_URL=jdbc:postgresql://shard2-replica:5432/shortener
SHARD_DB_USER=shortener
SHARD_DB_PASSWORD=shortener

# Analytics DB
ANALYTICS_DB_URL=jdbc:postgresql://control-db:5432/shortener
ANALYTICS_DB_USER=shortener
ANALYTICS_DB_PASSWORD=shortener
ANALYTICS_DB_POOL_SIZE=5

# Redis & Kafka
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP=kafka:19092

